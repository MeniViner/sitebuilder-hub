{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Site Builder Mongo reconciliation report",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "readOnly", "summary", "inventory", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "readOnly": { "const": true },
    "summary": {
      "type": "object",
      "required": ["rows", "warnings", "blockers", "exitCode"],
      "properties": {
        "rows": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "blockers": { "type": "integer", "minimum": 0 },
        "exitCode": { "enum": [0, 10, 20] }
      }
    },
    "inventory": { "type": "array", "items": { "$ref": "#/$defs/inventoryRow" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
  },
  "$defs": {
    "inventoryRow": {
      "type": "object",
      "required": ["hubSiteId", "siteIdentityKey", "siteCode", "builderSiteId", "sourceDatabase", "safeCollectionName", "physicalCollectionExists", "runtimeConfigPath", "runtimeSiteId", "runtimeStorageBackend", "runtimeBackendOrigin", "sharePointSiteUrl", "migrationState", "status", "warnings", "blockers"]
    },
    "finding": {
      "type": "object",
      "required": ["severity", "code", "subject", "message"],
      "properties": { "severity": { "enum": ["info", "warning", "blocker"] } }
    }
  }
}
